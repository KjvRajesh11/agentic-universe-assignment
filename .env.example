# Application Security Configuration
# Generate 32-byte (64 hex characters) cryptographically secure random keys:
# $ openssl rand -hex 32

APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_HMAC_SECRET=another_random_secret_string_or_hex_for_hmac_fingerprinting_at_least_32_bytes

# Optional Database and Logging settings
DB_PATH=agentic.db
LOG_LEVEL=INFO
